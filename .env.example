# Copy this file to .env for local development and replace the placeholders. Never commit .env.
# On Vercel, set the same variables in Project Settings > Environment Variables instead
# (never the local values: each environment gets its own database, secret and URL).

# --- Local Docker database (docker-compose.yml). Local development only: not used on Vercel.
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=waywise
POSTGRES_PORT=5434

# --- Database connections
# DATABASE_URL: the DIRECT connection. Used by the Prisma CLI (prisma.config.mjs: generate,
# migrate) and by the app when DATABASE_URL_POOLED is empty.
#   Local: must match the POSTGRES_* values above.
#   Vercel (Production and Preview): Neon's direct URL (host without "-pooler").
#   Required at build time too: `npm install` runs `prisma generate`.
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5434/waywise?schema=public
# DATABASE_URL_POOLED: the POOLED connection the app uses at runtime (lib/db.js).
#   Local: leave empty (the app then uses DATABASE_URL).
#   Vercel: Neon's pooled URL (host contains "-pooler"), e.g.
#   postgresql://your_neon_user:your_neon_password@ep-example-123456-pooler.region.aws.neon.tech/neondb?sslmode=require
# Use a separate Neon branch for Preview so preview deployments never touch production data.
DATABASE_URL_POOLED=

# --- Better Auth. Generate the secret with: openssl rand -base64 32  (at least 32 characters)
# Use a different secret for each environment (local, Preview, Production).
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# The URL the app runs on (used for cookies and the allowed-origin check). Sign-in only
# works from this exact origin.
#   Local: http://localhost:3000
#   Production: https://your-production-domain
#   Preview: a stable address such as the branch URL https://<project>-git-dev-<team>.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Email from the admin panel (lib/email/send-email.js). Restart the server after changes.
#   smtp = send through the SMTP server below
#   log  = send nothing, only log that an email would have been sent (for testing)
#   leave empty = email not set up (sending shows an error in the admin panel)
# Suggested: smtp in Production, log in Preview.
EMAIL_TRANSPORT=log
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true. SMTP_PASSWORD must be a Google
# "App password" (needs 2-Step Verification), never the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
# Sender shown to the recipient. With Gmail it must be the same address as SMTP_USER.
EMAIL_FROM="Way Wise Global <your_address@gmail.com>"
# Optional: where replies go (leave empty to use EMAIL_FROM)
EMAIL_REPLY_TO=
